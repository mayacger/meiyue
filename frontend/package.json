{
  "name": "meiyue-mall-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "美月商城前端 pnpm monorepo（买家PC/Taro移动/商家Pro/平台Pro）",
  "scripts": {
    "dev:buyer": "pnpm --filter @meiyue/web-buyer dev",
    "dev:seller": "pnpm --filter @meiyue/web-seller dev",
    "dev:admin": "pnpm --filter @meiyue/web-admin dev",
    "dev:taro:h5": "pnpm --filter @meiyue/taro-buyer dev:h5",
    "build:buyer": "pnpm --filter @meiyue/web-buyer build",
    "build:seller": "pnpm --filter @meiyue/web-seller build",
    "build:admin": "pnpm --filter @meiyue/web-admin build",
    "build:taro:h5": "pnpm --filter @meiyue/taro-buyer build:h5",
    "build": "pnpm --filter @meiyue/web-buyer --filter @meiyue/web-seller --filter @meiyue/web-admin run build",
    "lint": "pnpm -r --if-present lint"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0"
}
