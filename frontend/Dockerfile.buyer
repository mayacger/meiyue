# 买家 PC 静态站（I34）
FROM node:20-alpine AS build
WORKDIR /src
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages ./packages
COPY apps/web-buyer ./apps/web-buyer
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @meiyue/web-buyer run build

FROM nginx:1.27-alpine
COPY apps/web-buyer/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/apps/web-buyer/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=15s --timeout=3s --retries=5 \
  CMD wget -qO- http://127.0.0.1/ | grep -q meiyue || exit 1
