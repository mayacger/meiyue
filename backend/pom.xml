<?xml version="1.0" encoding="UTF-8"?>
<!--
  美月商城（Meiyue Mall）后端父 POM
  定位：Maven 多模块模块化单体（Spring Boot 3 + Java 21）
  对应规划：ecommerce-platform-plan.md 第6.1 / 第5.4 节
  groupId：com.meiyuemall
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.6</version>
    <relativePath/>
  </parent>

  <groupId>com.meiyuemall</groupId>
  <artifactId>meiyue-mall-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>meiyue-mall-parent</name>
  <description>美月商城后端父工程：统一依赖管理与模块列表</description>

  <modules>
    <module>meiyue-common</module>
    <module>meiyue-identity</module>
    <module>meiyue-tenant</module>
    <module>meiyue-catalog</module>
    <module>meiyue-decoration</module>
    <module>meiyue-trade</module>
    <module>meiyue-payment</module>
    <module>meiyue-logistics</module>
    <module>meiyue-aftersale</module>
    <module>meiyue-ai-assist</module>
    <module>meiyue-support</module>
    <module>meiyue-platform</module>
    <module>meiyue-boot</module>
    <module>meiyue-worker</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <meiyue.version>0.1.0-SNAPSHOT</meiyue.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.meiyuemall</groupId>
        <artifactId>meiyue-common</artifactId>
        <version>${meiyue.version}</version>
      </dependency>
      <dependency>
        <groupId>com.meiyuemall</groupId>
        <artifactId>meiyue-identity</artifactId>
        <version>${meiyue.version}</version>
      </dependency>
      <dependency>
        <groupId>com.meiyuemall</groupId>
        <artifactId>meiyue-tenant</artifactId>
        <version>${meiyue.version}</version>
      </dependency>
      <dependency>
        <groupId>com.meiyuemall</groupId>
        <artifactId>meiyue-catalog</artifactId>
        <version>${meiyue.version}</version>
      </dependency>
      <dependency>
        <groupId>com.meiyuemall</groupId>
        <artifactId>meiyue-decoration</artifactId>
        <version>${meiyue.version}</version>
      </dependency>
      <dependency>
        <groupId>com.meiyuemall</groupId>
        <artifactId>meiyue-trade</artifactId>
        <version>${meiyue.version}</version>
      </dependency>
      <dependency>
        <groupId>com.meiyuemall</groupId>
        <artifactId>meiyue-payment</artifactId>
        <version>${meiyue.version}</version>
      </dependency>
      <dependency>
        <groupId>com.meiyuemall</groupId>
        <artifactId>meiyue-logistics</artifactId>
        <version>${meiyue.version}</version>
      </dependency>
      <dependency>
        <groupId>com.meiyuemall</groupId>
        <artifactId>meiyue-aftersale</artifactId>
        <version>${meiyue.version}</version>
      </dependency>
      <dependency>
        <groupId>com.meiyuemall</groupId>
        <artifactId>meiyue-ai-assist</artifactId>
        <version>${meiyue.version}</version>
      </dependency>
      <dependency>
        <groupId>com.meiyuemall</groupId>
        <artifactId>meiyue-support</artifactId>
        <version>${meiyue.version}</version>
      </dependency>
      <dependency>
        <groupId>com.meiyuemall</groupId>
        <artifactId>meiyue-platform</artifactId>
        <version>${meiyue.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
